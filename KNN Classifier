import pandas as pd
from sklearn.model_selection import train_test_split
from sklearn.neighbors import KNeighborsClassifier
from sklearn.metrics import accuracy_score


df = pd.read_csv('penguins.csv') #загружаем датасет
df = df.dropna() #удаляем строки с пропусками

#Разделяем на признаки. Предсказываем вид пингвина по длине и глубине клюва.
labels = df['species']
features = df[['bill_length_mm', 'bill_depth_mm']]

#Делим на тестовую и обучающую часть
train_features, test_features, train_labels, test_labels = train_test_split(
    features, labels, test_size=0.2, random_state=123
)

best_acc = 0.0
bed_acc = 1.0

#Перебираем параметры kNN
for k in range(1, 11):
    for w in ['uniform', 'distance']:
        #Загружаем модель и обучаем её
        model = KNeighborsClassifier(n_neighbors=k, weights=w)
        model.fit(train_features, train_labels)

        #Предсказываем и считаем accuracy на тестовой выборке
        predictions = model.predict(test_features)
        acc = accuracy_score(test_labels, predictions)

        #Ищем лучший и худщий результат
        if acc > best_acc:
            best_acc = acc
        if acc < bed_acc:
            bed_acc = acc

print('Лучшая accuracy: {:.6f}'.format(best_acc))
print('Худшая accuracy: {:.6f}'.format(bed_acc))
